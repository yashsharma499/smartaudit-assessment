# --- Database ---------------------------------------------------------------
# Leave empty to run with an in-memory MongoDB (auto-seeded on startup).
# Set it to use a real database, e.g. mongodb://127.0.0.1:27017/smartaudit
# or a MongoDB Atlas connection string.
MONGO_URI=

# --- API ---------------------------------------------------------------------
PORT=4000

# --- AI engine ---------------------------------------------------------------
# MOCK_AI=true  -> deterministic local AI engine (no key needed, 400 ms simulated latency)
# MOCK_AI=false -> OpenAI for risk assessment + embeddings, with automatic fallback to the mock
MOCK_AI=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Max LLM requests per minute (simple client-side rate limit)
AI_MAX_RPM=60
MOCK_AI_DELAY_MS=400

# --- Background worker -------------------------------------------------------
WORKER_POLL_MS=1000
WORKER_CONCURRENCY=2
# A PROCESSING job whose lock is older than this is considered crashed and re-queued
WORKER_LOCK_TTL_MS=30000
WORKER_MAX_ATTEMPTS=3
